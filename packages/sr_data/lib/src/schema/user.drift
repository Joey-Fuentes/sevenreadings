-- Per-user data. Lives in its own database so content updates never touch it.
-- Everything here must be safe to create twice: drift creates tables with
-- IF NOT EXISTS but emits index statements as written, and a first open that
-- is interrupted before the schema version is recorded (seen on the web,
-- 2026-09-15) runs onCreate again on the next launch.

CREATE TABLE bookmarks (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  verse_id INTEGER NOT NULL,
  label TEXT,
  created_at INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS ix_bookmarks_verse ON bookmarks (verse_id);

CREATE TABLE notes (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  start_verse_id INTEGER NOT NULL,
  end_verse_id INTEGER NOT NULL,
  body TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS ix_notes_range
  ON notes (start_verse_id, end_verse_id);

CREATE TABLE reading_positions (
  translation_id TEXT NOT NULL PRIMARY KEY,
  verse_id INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE settings (
  name TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

notesForVerse:
  SELECT * FROM notes
  WHERE start_verse_id <= :verseId AND end_verse_id >= :verseId
  ORDER BY updated_at DESC;

allNotes: SELECT * FROM notes ORDER BY updated_at DESC;

bookmarkForVerse: SELECT * FROM bookmarks WHERE verse_id = :verseId LIMIT 1;

allBookmarks: SELECT * FROM bookmarks ORDER BY created_at DESC;
